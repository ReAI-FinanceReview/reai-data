# Local development settings for host-based execution against docker-compose.yml
ENVIRONMENT=development
LOG_LEVEL=INFO

# The app runs on the host, so DATABASE_URL needs the published host port, not the
# container port. docker-compose.yml publishes with POSTGRES_PORT, and Compose reads
# it from this same .env, so changing this one line moves both sides. Keep it above
# DATABASE_URL: python-dotenv resolves references top to bottom. Hardcoding the port
# in DATABASE_URL would aim host-side tools -- bootstrap_db.py included, and it
# opens with DROP SCHEMA public CASCADE -- at whatever already occupies the old port.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://reai:reai@localhost:${POSTGRES_PORT:-5432}/reai
# Uncomment to publish PostgreSQL on loopback only. Only docker-compose.yml reads it.
# POSTGRES_HOST_IP=127.0.0.1

# OpenAI-backed steps require a real key before analyze/embed runs.
OPENAI_API_KEY=replace_me

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=reai-data
MINIO_USE_SSL=false

ENABLE_PARQUET_WRITE=true

# Keep integration tests isolated from the dev database.
# TEST_DATABASE_URL=postgresql://testuser:testpass@localhost:5433/testdb
