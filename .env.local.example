# Local development settings for host-based execution against docker-compose.yml
ENVIRONMENT=development
LOG_LEVEL=INFO

# The app runs on the host, so this is the published host port, not the container
# port. It derives from POSTGRES_PORT, the same variable docker-compose.yml
# publishes with, so moving the port moves both sides at once. Hardcoding it here
# would aim host-side tools -- bootstrap_db.py included, and it opens with
# DROP SCHEMA public CASCADE -- at whatever already occupies the old port.
DATABASE_URL=postgresql+psycopg2://reai:reai@localhost:${POSTGRES_PORT:-5432}/reai

# OpenAI-backed steps require a real key before analyze/embed runs.
OPENAI_API_KEY=replace_me

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=reai-data
MINIO_USE_SSL=false

ENABLE_PARQUET_WRITE=true

# Keep integration tests isolated from the dev database.
# TEST_DATABASE_URL=postgresql://testuser:testpass@localhost:5433/testdb
